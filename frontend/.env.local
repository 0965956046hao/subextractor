# Public URL của backend (tunnel Cloudflare).
# Đổi tunnel → sửa dòng này + restart `npm run dev`.
NEXT_PUBLIC_TUNNEL_URL=https://enough-desktops-prices-configured.trycloudflare.com

# Proxy đích cho Mini App (/be/* → tunnel này). Trên Vercel: set env BACKEND_ORIGIN.
BACKEND_ORIGIN=https://enough-desktops-prices-configured.trycloudflare.com
