# Facebook App credentials (NEVER commit real secrets).
# Create an app at https://developers.facebook.com/ and copy these values.
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret

# Default Page ID (optional; can be passed via --page-id or picked automatically).
FACEBOOK_PAGE_ID=your_page_id

# Page access token (optional; normally obtained via `facebook-uploader auth`).
# Leave empty to use the token store created by `auth`.
FACEBOOK_PAGE_ACCESS_TOKEN=

# Graph API version (verify current supported version at developers.facebook.com).
FACEBOOK_GRAPH_API_VERSION=v21.0

# Default publish behavior (true/false). When true, upload/reel publish immediately
# unless --publish=false is given.
FACEBOOK_DEFAULT_PUBLISH=false

# Optional override of the OAuth redirect URI (must match the app's settings).
# FACEBOOK_REDIRECT_URI=http://localhost:8080/callback

# Optional custom token store path.
# FACEBOOK_TOKEN_STORE=~/.config/facebook-uploader/tokens.json
